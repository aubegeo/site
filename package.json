{
  "name": "tablet-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "serve": "serve .output/public -p 3000",
    "previewdist": "nuxt generate && serve dist",
    "bootstrap": "npm i && npm i --prefix functions",
    "clean": "rm -rf .firebase .nuxt .output node_modules functions/node_modules functions/lib firebase-debug.log ui-debug.log",
    "reset": "npm-run-all --sequential clean bootstrap",
    "verifport": "lsof -i :8080 & lsof -i :5000 & lsof -i :4000",
    "killport": "kill -9 <PID>",
    "dev": "npm-run-all --parallel build:functions:watch dev:nuxt firebase:start",
    "dev:restore": "npm-run-all --parallel build:functions:watch dev:nuxt firebase:restore",
    "build:nuxt": "nuxt build",
    "build:nuxt:firebase": "npm run build:nuxt -- --preset=firebase",
    "build:nuxt:watch": "nuxt build --watch",
    "build:functions": "npm run --prefix functions build",
    "build:functions:watch": "npm run --prefix functions build:watch",
    "deploy": "npm run deploy:prepare && npm run deploy:firebase",
    "deploy:prepare": "npm-run-all --sequential clean bootstrap build:nuxt:firebase build:functions",
    "deploy:firebase": "firebase deploy",
    "dev:nuxt": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "firebase:start": "firebase emulators:start",
    "firebase:export": "firebase emulators:export ./local-firestore-backup",
    "firebase:restore": "firebase emulators:start --import ./local-firestore-backup",
    "content": "npm run build:nuxt:firebase && firebase deploy"
  },
  "dependencies": {
    "@nuxt/content": "^3.5.1",
    "@nuxt/image": "^1.10.0",
    "@nuxtjs/i18n": "^9.5.2",
    "@nuxtjs/robots": "^5.2.10",
    "@nuxtjs/sitemap": "^7.3.0",
    "@vueuse/head": "^2.0.0",
    "axios": "^1.8.4",
    "core-js": "^3.25.3",
    "dotenv": "^16.5.0",
    "firebase": "^11.1.0",
    "firebase-admin": "^13.2.0",
    "firebase-functions": "^6.0.1",
    "ipx": "^3.0.3",
    "nuxt": "^3.16.2",
    "nuxt-i18n": "^2.4.1",
    "nuxt-simple-sitemap": "^4.4.1",
    "puppeteer": "^24.6.1",
    "sharp": "^0.34.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@nuxt/types": "^2.18.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.0.0"
  }
}
